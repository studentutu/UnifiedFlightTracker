{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build", "-G", "Ninja",
                     "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                     "-DCMAKE_BUILD_TYPE=Debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--parallel"],
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": ["cmake: configure"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}/build/vcqtdb",
            "args": ["--url", "http://localhost:5001"],
            "dependsOn": ["cmake: build"],
            "problemMatcher": []
        }
    ]
}
