{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "vcqtdb (debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/vcqtdb",
            "args": ["--url", "http://localhost:5001"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "cmake: build",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": true }
            ]
        }
    ]
}
